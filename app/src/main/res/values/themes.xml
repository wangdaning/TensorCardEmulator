<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TensorCardEmulator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Error Colors (REQUIRED) -->
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Surface & Background -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="android:colorForeground">@color/black</item>
        
        <!-- Text Appearances (REQUIRED for MaterialSwitch) -->
        <item name="textAppearanceBodyMedium">@style/TextAppearance.MaterialComponents.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.MaterialComponents.BodySmall</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.MaterialComponents.Button</item>
        
        <!-- Window Settings -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
